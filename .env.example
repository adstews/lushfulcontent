# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DC=

# Close CRM
CLOSE_API_KEY=
# Lead pipeline statuses
CLOSE_STATUS_NEW=
CLOSE_STATUS_QUALIFIED=
CLOSE_STATUS_BAD_FIT=
# Appointment funnel statuses (auto-set by /api/lead-update on book/book-calendly,
# manually transitioned by sales after the call/appt)
CLOSE_STATUS_CALL_BOOKED=
CLOSE_STATUS_CALL_SHOWED=
CLOSE_STATUS_CALL_NO_SHOW=
CLOSE_STATUS_APPT_BOOKED=
CLOSE_STATUS_APPT_SHOWED=
CLOSE_STATUS_APPT_NO_SHOW=

# Close custom field IDs (created in Close UI; format: cf_xxxxxxxxx)
CLOSE_CF_SOURCE=
CLOSE_CF_UTM_SOURCE=
CLOSE_CF_UTM_MEDIUM=
CLOSE_CF_UTM_CAMPAIGN=
CLOSE_CF_UTM_CONTENT=
CLOSE_CF_UTM_TERM=
CLOSE_CF_FBCLID=
CLOSE_CF_GCLID=
CLOSE_CF_REFERRER=
CLOSE_CF_LANDING_PAGE=
CLOSE_CF_QUALIFIED=
CLOSE_CF_CTA_CLICKED=
CLOSE_CF_BOOKED=
# Out-of-area travel gate. Set by /api/lead-update when the visitor confirms
# (or declines) travel on the girthfill-form stepTravel step.
CLOSE_CF_TRAVEL_STATUS=

# Calendly webhook (invitee.created → Close "Call Booked")
# Shared secret — Calendly can't sign or send custom headers for this account,
# so the secret rides in the callback URL (?secret=<value>). See
# docs/calendly-setup.md. Missing → the webhook rejects all requests (401).
CALENDLY_WEBHOOK_SECRET=

# Booking reminder email (api/cron/booking-reminders). Sender must be an email
# account connected to Close; CLOSE_CF_CALL_TIME is the "Scheduled Call Time"
# datetime custom field (cf_xxx) the webhook writes the call start time to.
CLOSE_REMINDER_FROM=
CLOSE_CF_CALL_TIME=

# SendBlue iMessage middleware
# (https://docs.sendblue.com)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# The SendBlue line (E.164 phone number) outbound iMessages should send from.
# Find it with: GET /api/sendblue/console/sendblue-lines (auth-gated).
SENDBLUE_FROM_NUMBER=
# Shared secret required on inbound webhooks. Configure SendBlue to POST to
# /api/sendblue/inbound?secret=<value> or send X-Webhook-Secret: <value>.
# Leave blank to disable the check (not recommended).
SENDBLUE_WEBHOOK_SECRET=

# Close Custom Activity used to log iMessages on the lead timeline.
# Create the activity type + fields in Close UI first — see docs/sendblue-setup.md.
CLOSE_CUSTOM_ACTIVITY_IMESSAGE=
CLOSE_CF_IMESSAGE_TEXT=
CLOSE_CF_IMESSAGE_DIRECTION=
CLOSE_CF_IMESSAGE_PHONE=
# Optional extras — only populated if the custom field exists in Close.
CLOSE_CF_IMESSAGE_MEDIA_URL=
CLOSE_CF_IMESSAGE_HANDLE=

# Reply console (/imessage page)
# Shared password used to sign in to the iMessage inbox at /imessage.
REPLY_CONSOLE_PASSWORD=
# Long random string (>= 16 chars) used to sign the session cookie.
# Rotating this invalidates everyone's session.
REPLY_CONSOLE_SESSION_SECRET=

# Web push (notifications for new inbound iMessages in the console)
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email or URL Apple/Mozilla/Google can reach if a push goes wrong.
VAPID_SUBJECT=mailto:noreply@lushfulaesthetics.com

# Sequences (drip campaign engine)
# Random hex string used to authorize the Vercel Cron tick at /api/cron/sequence-tick.
# Vercel injects the header `Authorization: Bearer $CRON_SECRET` on cron requests.
CRON_SECRET=

# Optional shared secret for the Close webhook receiver at
# /api/sendblue/close-webhook. If set, the webhook URL must include
# ?secret=<value> or send X-Webhook-Secret: <value>.
CLOSE_WEBHOOK_SECRET=

# iMessage provider selector
# Set to 'sendblue' to use the legacy SendBlue gateway; default (or unset) routes
# through Blooio.
IMESSAGE_PROVIDER=

# Blooio iMessage gateway (https://blooio.com)
BLOOIO_API_KEY=
# Shared secret used to verify inbound Blooio webhook signatures.
BLOOIO_WEBHOOK_SIGNING_SECRET=
# E.164 number to send outbound iMessages from (optional; Blooio may assign one).
BLOOIO_FROM_NUMBER=
# Max new-conversation iMessages per day across all leads (anti-spam gate).
IMESSAGE_NEW_CONVO_DAILY_CAP=
