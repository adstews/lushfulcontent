# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DC=

# Close CRM
CLOSE_API_KEY=
CLOSE_STATUS_NEW=
CLOSE_STATUS_QUALIFIED=
CLOSE_STATUS_BAD_FIT=

# Close custom field IDs (created in Close UI; format: cf_xxxxxxxxx)
CLOSE_CF_SOURCE=
CLOSE_CF_UTM_SOURCE=
CLOSE_CF_UTM_MEDIUM=
CLOSE_CF_UTM_CAMPAIGN=
CLOSE_CF_UTM_CONTENT=
CLOSE_CF_FBCLID=
CLOSE_CF_GCLID=
CLOSE_CF_QUALIFIED=
CLOSE_CF_CTA_CLICKED=

# SendBlue iMessage middleware
# (https://docs.sendblue.com)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# The SendBlue line (E.164 phone number) outbound iMessages should send from.
# Find it with: GET /api/sendblue/console/sendblue-lines (auth-gated).
SENDBLUE_FROM_NUMBER=
# Shared secret required on inbound webhooks. Configure SendBlue to POST to
# /api/sendblue/inbound?secret=<value> or send X-Webhook-Secret: <value>.
# Leave blank to disable the check (not recommended).
SENDBLUE_WEBHOOK_SECRET=

# Close Custom Activity used to log iMessages on the lead timeline.
# Create the activity type + fields in Close UI first — see docs/sendblue-setup.md.
CLOSE_CUSTOM_ACTIVITY_IMESSAGE=
CLOSE_CF_IMESSAGE_TEXT=
CLOSE_CF_IMESSAGE_DIRECTION=
CLOSE_CF_IMESSAGE_PHONE=
# Optional extras — only populated if the custom field exists in Close.
CLOSE_CF_IMESSAGE_MEDIA_URL=
CLOSE_CF_IMESSAGE_HANDLE=

# Reply console (/imessage page)
# Shared password used to sign in to the iMessage inbox at /imessage.
REPLY_CONSOLE_PASSWORD=
# Long random string (>= 16 chars) used to sign the session cookie.
# Rotating this invalidates everyone's session.
REPLY_CONSOLE_SESSION_SECRET=

# Web push (notifications for new inbound iMessages in the console)
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email or URL Apple/Mozilla/Google can reach if a push goes wrong.
VAPID_SUBJECT=mailto:noreply@lushfulaesthetics.com
